# Environment Variables for CyberOptix E-commerce

# Email Configuration (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=CyberOptix <your-email@gmail.com>

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 2C2P/KBZPay Configuration for Myanmar Local Payments
2C2P_MERCHANT_ID=your_merchant_id_here
2C2P_SECRET_KEY=your_secret_key_here

# For testing with 2C2P Sandbox
2C2P_API_URL=https://sandbox-pgw.2c2p.com/payment/4.1/
2C2P_FRONTEND_URL=https://sandbox-pgw-ui.2c2p.com/payment/4.1/#/token/

# For production (when you have real merchant account)
# 2C2P_API_URL=https://pgw.2c2p.com/payment/4.1/
# 2C2P_FRONTEND_URL=https://pgw-ui.2c2p.com/payment/4.1/#/token/

# Database Configuration (if using PostgreSQL/MySQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/cyberoptix
# DATABASE_URL=mysql://user:password@localhost:3306/cyberoptix

# Security Settings (generate new secret key for production)
# SECRET_KEY=your-super-secret-key-here

# Debug Mode (set to False in production)
# DEBUG=False

# Allowed Hosts (add your domain for production)
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Instructions:
# 1. Copy this file to .env
# 2. Fill in your actual credentials
# 3. Never commit .env to version control
# 4. Keep your credentials secure