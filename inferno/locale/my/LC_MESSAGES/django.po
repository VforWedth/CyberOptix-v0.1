#: .\venv\Lib\site-packages\django\core\validators.py:402
#, python-format
msgid "Ensure this value is %(limit_value)s (it is %(show_value)s)."
msgstr ""
"ဤတန်ဖိုးသည် %(limit_value)s ဖြစ်ကြောင်း သေချာပါစေ (လက်ရှိ %(show_value)s)။"

#: .\venv\Lib\site-packages\django\core\validators.py:437
#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "ဤတန်ဖိုးသည် %(limit_value)s ထက်နည်း သို့မဟုတ် ညီမျှကြောင်း သေချာပါစေ။"

#: .\venv\Lib\site-packages\django\core\validators.py:446
#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
